{
  "rules": {
    ".read": false,
    ".write": false,
    "labs": {
      "$lab": {
        ".read": "(auth != null && root.child('members').child($lab).child(auth.uid).val() == true) || (auth != null && root.child('deviceUsers').child(auth.uid).val() == $lab)",
        "current": {
          ".validate": "newData.hasChildren([\"gasRaw\", \"flameDetected\", \"dhtOk\", \"gasReady\", \"gasWarmupRemainingS\", \"alarmOn\", \"alarmReason\", \"safetyStatus\", \"wifiRssi\", \"uptimeS\", \"updatedAt\", \"ackCommandId\", \"ackResult\", \"firmwareVersion\", \"appliedSettings\"]) && (newData.child('dhtOk').val() == false || newData.hasChildren(['temperatureC','humidityPct']))",
          "flameDetected": {
            ".validate": "newData.isBoolean()"
          },
          "dhtOk": {
            ".validate": "newData.isBoolean()"
          },
          "gasReady": {
            ".validate": "newData.isBoolean()"
          },
          "alarmOn": {
            ".validate": "newData.isBoolean()"
          },
          "temperatureC": {
            ".validate": "newData.isNumber() && newData.val() >= -20 && newData.val() <= 80"
          },
          "humidityPct": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "gasRaw": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4095"
          },
          "gasWarmupRemainingS": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
          },
          "wifiRssi": {
            ".validate": "newData.isNumber() && newData.val() >= -127 && newData.val() <= 0"
          },
          "uptimeS": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 1000"
          },
          "alarmReason": {
            ".validate": "newData.isString() && (newData.val() == 'none' || newData.val() == 'flame' || newData.val() == 'gas' || newData.val() == 'temperature' || newData.val() == 'multiple' || newData.val() == 'manual_test')"
          },
          "safetyStatus": {
            ".validate": "newData.isString() && (newData.val() == 'normal' || newData.val() == 'warming_up' || newData.val() == 'sensor_fault' || newData.val() == 'alarm')"
          },
          "ackResult": {
            ".validate": "newData.isString() && (newData.val() == 'none' || newData.val() == 'accepted')"
          },
          "ackCommandId": {
            ".validate": "newData.isString() && newData.val().length <= 63"
          },
          "firmwareVersion": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "appliedSettings": {
            ".validate": "newData.hasChildren(['temperatureHigh','temperatureClear','gasHigh','gasClear'])",
            "temperatureHigh": {
              ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 60"
            },
            "temperatureClear": {
              ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= newData.parent().child('temperatureHigh').val() - 1"
            },
            "gasHigh": {
              ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 4000 && newData.val() % 1 == 0"
            },
            "gasClear": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < newData.parent().child('gasHigh').val() && newData.val() % 1 == 0"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          },
          ".write": "auth != null && root.child('deviceUsers').child(auth.uid).val() == $lab && newData.exists()"
        },
        "history": {
          ".indexOn": [
            "updatedAt"
          ],
          "$slot": {
            ".validate": "newData.hasChildren([\"gasRaw\", \"flameDetected\", \"dhtOk\", \"gasReady\", \"gasWarmupRemainingS\", \"alarmOn\", \"alarmReason\", \"safetyStatus\", \"wifiRssi\", \"uptimeS\", \"updatedAt\", \"ackCommandId\", \"ackResult\", \"firmwareVersion\", \"appliedSettings\"]) && (newData.child('dhtOk').val() == false || newData.hasChildren(['temperatureC','humidityPct']))",
            "flameDetected": {
              ".validate": "newData.isBoolean()"
            },
            "dhtOk": {
              ".validate": "newData.isBoolean()"
            },
            "gasReady": {
              ".validate": "newData.isBoolean()"
            },
            "alarmOn": {
              ".validate": "newData.isBoolean()"
            },
            "temperatureC": {
              ".validate": "newData.isNumber() && newData.val() >= -20 && newData.val() <= 80"
            },
            "humidityPct": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "gasRaw": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4095"
            },
            "gasWarmupRemainingS": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
            },
            "wifiRssi": {
              ".validate": "newData.isNumber() && newData.val() >= -127 && newData.val() <= 0"
            },
            "uptimeS": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 1000"
            },
            "alarmReason": {
              ".validate": "newData.isString() && (newData.val() == 'none' || newData.val() == 'flame' || newData.val() == 'gas' || newData.val() == 'temperature' || newData.val() == 'multiple' || newData.val() == 'manual_test')"
            },
            "safetyStatus": {
              ".validate": "newData.isString() && (newData.val() == 'normal' || newData.val() == 'warming_up' || newData.val() == 'sensor_fault' || newData.val() == 'alarm')"
            },
            "ackResult": {
              ".validate": "newData.isString() && (newData.val() == 'none' || newData.val() == 'accepted')"
            },
            "ackCommandId": {
              ".validate": "newData.isString() && newData.val().length <= 63"
            },
            "firmwareVersion": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "appliedSettings": {
              ".validate": "newData.hasChildren(['temperatureHigh','temperatureClear','gasHigh','gasClear'])",
              "temperatureHigh": {
                ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 60"
              },
              "temperatureClear": {
                ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= newData.parent().child('temperatureHigh').val() - 1"
              },
              "gasHigh": {
                ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 4000 && newData.val() % 1 == 0"
              },
              "gasClear": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < newData.parent().child('gasHigh').val() && newData.val() % 1 == 0"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && root.child('deviceUsers').child(auth.uid).val() == $lab && newData.exists() && $slot.matches(/^slot[0-9]{1,4}$/)"
          }
        },
        "alerts": {
          ".indexOn": [
            "updatedAt"
          ],
          "$slot": {
            ".write": "auth != null && root.child('deviceUsers').child(auth.uid).val() == $lab && newData.exists() && $slot.matches(/^slot[0-9]{1,2}$/)",
            ".validate": "newData.hasChildren(['reason','state','occurredAt','updatedAt'])",
            "reason": {
              ".validate": "newData.isString() && (newData.val() == 'flame' || newData.val() == 'gas' || newData.val() == 'temperature' || newData.val() == 'multiple' || newData.val() == 'manual_test' || newData.val() == 'sensor_fault')"
            },
            "state": {
              ".validate": "newData.val() == 'active' || newData.val() == 'clear'"
            },
            "occurredAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 5000"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() >= now - 10000 && newData.val() <= now + 1000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "command": {
          ".write": "auth != null && root.child('members').child($lab).child(auth.uid).val() == true && newData.exists()",
          ".validate": "newData.hasChildren(['id','action','issuedAt','by'])",
          "id": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 63"
          },
          "action": {
            ".validate": "newData.val() == 'test_alarm' || newData.val() == 'stop_test'"
          },
          "issuedAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 2000 && newData.val() <= now + 1000"
          },
          "by": {
            ".validate": "newData.val() == auth.uid"
          },
          "$other": {
            ".validate": false
          }
        },
        "config": {
          ".validate": "newData.hasChildren(['temperatureHigh','temperatureClear','gasHigh','gasClear'])",
          "temperatureHigh": {
            ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 60"
          },
          "temperatureClear": {
            ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= newData.parent().child('temperatureHigh').val() - 1"
          },
          "gasHigh": {
            ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 4000 && newData.val() % 1 == 0"
          },
          "gasClear": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < newData.parent().child('gasHigh').val() && newData.val() % 1 == 0"
          },
          "$other": {
            ".validate": false
          },
          ".write": "auth != null && root.child('members').child($lab).child(auth.uid).val() == true && newData.exists()"
        }
      }
    }
  }
}
